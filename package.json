{
  "name": "lifeos",
  "version": "1.0.0",
  "description": "Life OS - Full-Stack Personal Management System",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:server": "npm --prefix server run dev",
    "start:server": "npm --prefix server start",
    "dev:client": "npm --prefix client run dev",
    "build:client": "npm --prefix client run build",
    "build": "npm --prefix client run build",
    "vercel-build": "npm --prefix client run build",
    "postinstall": "npm --prefix client install && npm --prefix server install",
    "dev": "concurrently -n \"server,client\" -c \"blue,magenta\" \"npm:dev:server\" \"npm:dev:client\"",
    "start": "npm --prefix server start",
    "test:features": "node server/testAllRequirements.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "google-auth-library": "^9.15.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.1.5"
  },
  "devDependencies": {
    "concurrently": "^10.0.5"
  }
}
